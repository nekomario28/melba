{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sone.dev/schemas/sone.collection/v1",
  "title": "sone.collection/v1",
  "type": "object",
  "required": ["schema", "id", "name", "tracks", "importedAt", "provenance"],
  "properties": {
    "schema": {"const": "sone.collection/v1"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "importedAt": {"type": "string", "minLength": 1},
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "artist": {"type": "string"},
          "album": {"type": "string"},
          "durationMs": {"type": "integer", "minimum": 0},
          "playUri": {"type": "string"},
          "source": {"type": "string"},
          "props": {"type": "object", "additionalProperties": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "locator": {"type": "string"},
        "retrievedAt": {"type": "string"},
        "tool": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
