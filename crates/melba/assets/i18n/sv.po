msgid "Mode"
msgstr "Läge"

#: src/ui/settings.rs:1203
msgid "Off ignores environment variables. System uses them, and the OS proxy on macOS and Windows."
msgstr "”Av” ignorerar miljövariabler. ”System” använder dem, och operativsystemets proxy på macOS och Windows."

#: src/ui/settings.rs:1267
msgid "Not using a proxy."
msgstr "Ingen proxy används."

#: src/ui/settings.rs:1268
msgid "Using the system proxy."
msgstr "Systemets proxy används."

#: src/ui/settings.rs:1288
msgid "Use classic Winamp .wsz skins. Press Ctrl+M or click the skin logo to return. Drop a skin on either window to add it."
msgstr "Använd klassiska Winamp-skins (.wsz). Tryck Ctrl+M eller klicka på skinnets logotyp för att gå tillbaka. Släpp en skin på något av fönstren för att lägga till den."

#: src/ui/settings.rs:1292
msgid "Use classic Winamp .wsz skins. Press Cmd+Shift+M or click the skin logo to return. Drop a skin on either window to add it."
msgstr "Använd klassiska Winamp-skins (.wsz). Tryck Cmd+Shift+M eller klicka på skinnets logotyp för att gå tillbaka. Släpp en skin på något av fönstren för att lägga till den."

#: src/ui/settings.rs:1322
msgid "Keep a taskbar button for the mini player. The tray icon stays available when hidden."
msgstr "Behåll en knapp i aktivitetsfältet för minispelaren. Ikonen i systemfältet finns kvar när den är dold."

#: src/ui/settings.rs:1418
#, rust-format
msgid "Now showing {skin}. Another one is picked each time the mini player opens."
msgstr "Visas nu: {skin}. En annan väljs varje gång minispelaren öppnas."

#: src/ui/settings.rs:1482
msgid "A projectM visualiser for local playback. Open it here, from the top bar, with Ctrl+Shift+K, or from the mini player's V menu. Press ? or F1 for its shortcuts."
msgstr "En projectM-visualisering för lokal uppspelning. Öppna den här, från det övre fältet, med Ctrl+Shift+K eller från minispelarens V-meny. Tryck ? eller F1 för kortkommandon."

#: src/ui/settings.rs:1486
msgid "A projectM visualiser for local playback. Open it here, from the top bar, with Cmd+Shift+K, or from the mini player's V menu. Press ? or F1 for its shortcuts."
msgstr "En projectM-visualisering för lokal uppspelning. Öppna den här, från det övre fältet, med Cmd+Shift+K eller från minispelarens V-meny. Tryck ? eller F1 för kortkommandon."

#. Translators: {folder} is the path of the MilkDrop presets folder.
#: src/ui/settings.rs:1497
#, rust-format
msgid "None yet in {folder}. Add .milk files here. Melba downloads presets when MilkDrop first opens with an empty folder."
msgstr "Inga än i {folder}. Lägg .milk-filer här. Melba laddar ned förinställningar när MilkDrop öppnas första gången med en tom mapp."

